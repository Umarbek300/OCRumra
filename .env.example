# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Used by the app; host/port/db/user/password here must match the values below
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocrumra

# Used by docker-compose to provision the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocrumra
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Telegram ---
# Bot token from @BotFather. Required to start the bot (`npm run bot`);
# any non-empty placeholder is fine for running migrations/tests without a real bot.
TELEGRAM_BOT_TOKEN=

# --- Anthropic (Claude Vision passport OCR) ---
# Optional here — admin/migrate/health/test scripts run fine without it.
# Only the passport OCR worker step requires it, and fails clearly (not
# silently) if it's missing when real OCR processing actually starts.
ANTHROPIC_API_KEY=
# Safe default: a currently supported Claude vision-capable model.
# Override only if you have a specific reason to pin a different model.
ANTHROPIC_MODEL=claude-opus-5

# --- Future phases (not used yet — do not fill in) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_SHEETS_DEFAULT_DRIVE_FOLDER_ID=
