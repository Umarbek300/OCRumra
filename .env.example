# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Used by the app; host/port/db/user/password here must match the values below
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocrumra

# Used by docker-compose to provision the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocrumra
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

