# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Used by the app; host/port/db/user/password here must match the values below
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocrumra

# Used by docker-compose to provision the Postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocrumra
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Telegram ---
# Bot token from @BotFather. Required to start the bot (`npm run bot`);
# any non-empty placeholder is fine for running migrations/tests without a real bot.
TELEGRAM_BOT_TOKEN=

# --- Anthropic (Claude Vision passport OCR) ---
# Optional here — admin/migrate/health/test scripts run fine without it.
# Only the passport OCR worker step requires it, and fails clearly (not
# silently) if it's missing when real OCR processing actually starts.
ANTHROPIC_API_KEY=
# Safe default: a currently supported Claude vision-capable model.
# Override only if you have a specific reason to pin a different model.
ANTHROPIC_MODEL=claude-opus-5

# --- Google Sheets sync (per-departure-group passport export) ---
# Path to a Google service-account JSON key file (never the key material
# itself — see src/sheets/sheetsAuth.ts). Leave empty until that file is
# provisioned on the server; the sync worker fails clearly, only when it
# actually tries to authenticate, if this is missing.
GOOGLE_SHEETS_SERVICE_ACCOUNT_KEY_FILE=
# Drive folder a newly-created group spreadsheet is filed under. Optional.
GOOGLE_SHEETS_DRIVE_FOLDER_ID=
# Master switch for the Sheets sync worker (npm run sheets:worker). Keep
# false until the service account above is actually provisioned.
SHEETS_SYNC_ENABLED=false
# Per-request timeout (ms) for every Sheets/Drive API call. 30 seconds is a
# generous default — override only if you have a specific reason to.
GOOGLE_SHEETS_API_TIMEOUT_MS=30000
